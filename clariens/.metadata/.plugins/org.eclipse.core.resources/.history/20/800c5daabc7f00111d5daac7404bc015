function setSelectedZoomItem(selectedItem) {

  if (selectedItem.inputId == "zoomEmpresa") {
    $("#codColigada").val(selectedItem.CODCOLIGADA);
    $("#filialProtheus").val(selectedItem.FILIALPROTHEUS);
    reloadZoomFilterValues("zoomcCusto", "CODFILIAL," + selectedItem.FILIALPROTHEUS);
    limparCamposGestor();
  }

  if (selectedItem.inputId == "zoomcCusto") {
    $("#codCusto").val(selectedItem.CODCUSTO);
    $("#codAprov").val(selectedItem.CODAPROV);
    $("#emailAprov").val(selectedItem.EMAILAPROV);
    $("#gestorContrato").val(selectedItem.NOMEAPROV);
    if (selectedItem.EMAILAPROV != "") {
      var gestorFluig = getUserByMail(selectedItem.EMAILAPROV);
      if (gestorFluig && gestorFluig.colleagueId != "") {
        $("#idFlgGestCC").val(gestorFluig.colleagueId);
      } else {
        $("#idFlgGestCC").val("");
      }
    }
  }

  if (selectedItem.inputId == "zoomTemplate") {
    $("#idTemplate").val(selectedItem.ID_TEMPLATE);
  }

  if (selectedItem.inputId == "zoomPlanilha") {
    $("#idTipPlanilha").val(selectedItem.CODIGO);
  }

  if (selectedItem.inputId == "zoomContrato") {
    $("#idTipContrato").val(selectedItem.CODIGO);
  }

  if (selectedItem.inputId == "zoomCondpgto") {
    $("#codCondpgto").val(selectedItem.CODIGO);
  }

  if (selectedItem.inputId.indexOf("zoomProduto___") != -1) {
    var indice = selectedItem.inputId.split("___")[1];
    $("#codProduto___" + indice).val(selectedItem.CODPROD);
    $("#nomeProduto___" + indice).val(selectedItem.NOMEPROD);
    $("#Qtde___" + indice).val("0");
    $("#valorUnit___" + indice).val("0,00");
  }

}

function removedZoomItem(removedItem) {
  if (removedItem.inputId == "zoomEmpresa") {
    $("#codColigada").val("");
    $("#filialProtheus").val("");
    window["zoomcCusto"].clear();
    limparCamposGestor();
  }

  if (removedItem.inputId == "zoomcCusto") {
    limparCamposGestor();
  }

  if (removedItem.inputId == "zoomPlanilha") {
    $("#idTipPlanilha").val("");
  }

  if (removedItem.inputId == "zoomContrato") {
    $("#idTipContrato").val("");
  }

  if (removedItem.inputId == "zoomCondpgto") {
    $("#codCondpgto").val("");
  }

  if (removedItem.inputId.indexOf("zoomProduto___") != -1) {
    var indice = removedItem.inputId.split("___")[1];
    $("#codProduto___" + indice).val("");
    $("#nomeProduto___" + indice).val("");
  }
}

function limparCamposGestor() {
  $("#codCusto").val("");
  $("#codAprov").val("");
  $("#emailAprov").val("");
  $("#gestorContrato").val("");
  $("#idFlgGestCC").val("");
}

function activeAutoComp(idcampo) {
  if (window["AC_" + idcampo]) {
    window["AC_" + idcampo].removeAll();
    window["AC_" + idcampo].destroy();
  }

  window["AC_" + idcampo] = FLUIGC.autocomplete("#" + idcampo, {
    source: {
      url: "/api/public/ecm/dataset/search?datasetId=ds_fornecedor&searchField=cnscodnome&",
      contentType: "application/json",
      root: "content",
      pattern: "",
      limit: 10,
      offset: 0,
      patternKey: "searchValue",
      limitkey: "limit",
      offsetKey: "offset"
    },
    displayKey: "CODNOMFOR",
    tagClass: "label label-default",
    type: "tagAutocomplete",
    minLength: 3,
    tagMaxWidth: 400,
    maxTags: 1
  });

  if (!window["controleItemadd"]) {
    window["AC_" + idcampo].on("fluig.autocomplete.itemAdded", function (event) {
      var item = event.item;
      if (item.CODFOR == "") {
        FLUIGC.toast({
          title: "Atenção: ",
          message: "Fornecedor não cadastrado no Protheus, favor cadastrar antes de iniciar a solicitação!",
          type: "warning"
        });
      } else {
        $("#codigoFor").val(item.CODFOR);
        $("#lojaFor").val(item.LOJAFOR);
      }
    });

    window["AC_" + idcampo].on("fluig.autocomplete.itemRemoved", function () {
      $("#codigoFor").val("");
      $("#lojaFor").val("");
    });

    window["controleItemadd"] = "carregado";
  }
}




/*Ds Centro de Custo: Ele deve retornar as colunas CODFILIAL, CODCUSTO, EMAILAPROV e NOMEAPROV. Se o dataset não tiver o e-mail, não há como automatizar a busca do gestor no Fluig.
Filtros: O reloadZoomFilterValues envia uma constraint para o dataset. 
No exemplo, ele filtra o dataset de Centro de Custo pela coluna CODFILIAL, 
usando o valor da Filial da Empresa selecionada. O nome do campo de filtro (CODFILIAL) deve 
ser exatamente igual ao nome da coluna no dataset. Se o dataset tiver mais de um filtro, eles devem ser
separados por vírgula, seguindo o formato "campo1,valor1,campo2,valor2". */