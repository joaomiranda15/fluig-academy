function calculaTotal(objeto) {
  var ini = objeto.id.indexOf("_") + 3;
  var indice = objeto.id.substr(ini, 1);
  var valUnit = currencyToNumber($("#valorUnit___" + indice).val());
  var total = $("#Qtde___" + indice).val() * valUnit;
  $("#valorTotal___" + indice).val(numberToCurrency(total));
}

function configurarMascaras() {
  $('.masktelefone').each(function () {
    var behavior = function (val) {
      return val.replace(/\D/g, '').length === 11 ? '(00) 00000-0000' : '(00) 0000-00009';
    };
    $(this).mask(behavior, {
      onKeyPress: function (val, e, field, options) {
        field.mask(behavior.apply({}, arguments), options);
      }
    });
  });
}

// Flags de controle da criação do documento NetLex nesta sessão do form
let netlexCriado = false;
let netlexEmAndamento = false;

// Interceptado em fase de captura no botão #send-process-button da página pai:
// cria o documento no NetLex, abre o link em nova aba e re-dispara o envio padrão.
function interceptarEnvioNetlex(e) {

  // Documento já criado (re-clique ou clique após erro de validação do Fluig):
  // deixa o evento seguir o fluxo padrão sem duplicar o documento
  if (netlexCriado || document.getElementById("netlex_document_id").value !== "") {
    return;
  }

  e.preventDefault();
  e.stopImmediatePropagation();

  if (netlexEmAndamento) return; // chamada ao NetLex em curso — ignora cliques repetidos

  // Mesma checagem de obrigatórios do beforeSendValidate, antes de criar o documento
  arrError = [];
  campoObrig = [];
  verificaCampos($('.obrigatorio:visible'));
  if (arrError.length > 0) {
    exibeToastNetlex('Campos obrigatórios', arrError.join('; '), 'warning');
    return;
  }

  const numProcesso = obterNumProcesso();
  if (!numProcesso) {
    exibeToastNetlex('NetLex', 'Não foi possível identificar o número da solicitação (WKNumProces).', 'danger');
    return;
  }

  const valores = {
    template_id: $("#idTemplate").val(),
    empresa_filial: $("#zoomEmpresa").val(),
    centro_custo: $("#zoomcCusto").val(),
    gestor_contrato: $("#gestorContrato").val(),
    solicitante: $("#nomeCompleto").val(),
    email_solicitante: $("#email").val(),
    depto_solicitante: $("#departamento").val(),
    email_gestor: $("#emailAprov").val(),
    processo_id: numProcesso
  };

  const constraints = [];
  for (const campo in valores) {
    constraints.push({
      _field: campo,
      _initialValue: valores[campo],
      _finalValue: valores[campo],
      _type: 1, // MUST
      _likeSearch: false
    });
  }

  const sendBtn = e.currentTarget;

  netlexEmAndamento = true;
  const loading = criaLoadingNetlex();
  if (loading) loading.show();

  const finaliza = () => {
    netlexEmAndamento = false;
    if (loading) loading.hide();
  };

  const falha = (msg) => {
    finaliza();
    exibeToastNetlex('NetLex', msg, 'danger');
  };

  $.ajax({
    url: window.location.origin + '/api/public/ecm/dataset/datasets',
    type: 'POST',
    contentType: 'application/json',
    data: JSON.stringify({
      name: 'ds_criar_documento_netlex',
      fields: [],
      constraints: constraints,
      order: []
    }),
    success: function (response) {
      const values = response && response.content ? response.content.values : null;
      if (!values || values.length === 0) {
        falha('O serviço não retornou dados. Verifique o log do servidor.');
        return;
      }

      const row = values[0];
      if (row.ERRO === "1") {
        falha(row.MSG + (row.DETALHES ? ' — ' + row.DETALHES : ''));
        return;
      }

      document.getElementById("netlex_document_id").value = row.document_id || "";
      document.getElementById("netlex_document_name").value = row.document_name || "";
      document.getElementById("netlex_document_url").value = row.document_url || "";

      finaliza();
      netlexCriado = true;

      // O modal mantém o usuário na página; o clique no botão do modal é um
      // gesto novo, então o window.open abre a guia sem cair no popup blocker
      exibeModalNetlex(row, sendBtn);
    },
    error: function (xhr) {
      falha('Falha ao chamar o serviço (HTTP ' + xhr.status + '). Verifique o log do servidor.');
    }
  });
}

// Mostra os dados do contrato criado; o botão abre a guia do NetLex e envia o
// processo. Fechar o modal (X, ESC ou clique fora) também envia — garante que
// o processo seja iniciado sempre que o documento foi criado no NetLex.
// Sem interação, uma contagem regressiva envia automaticamente.
function exibeModalNetlex(row, sendBtn) {
  const temUrl = !!row.document_url;
  const SEGUNDOS_AUTO_ENVIO = 30;

  let envioDisparado = false;
  let timerAutoEnvio = null;

  const enviarProcesso = () => {
    if (envioDisparado) return;
    envioDisparado = true;
    if (timerAutoEnvio) clearInterval(timerAutoEnvio);
    sendBtn.click(); // re-dispara o envio padrão do Fluig
  };

  FLUIGC.modal({
    title: 'Contrato criado no NetLex',
    content:
      '<div class="bn-card bn-card-modal">' +
        '<div class="bn-header">' +
          '<div class="bn-icon">📄</div>' +
          '<div>' +
            '<div class="bn-label">Documento criado no NetLex</div>' +
            '<div class="bn-nome">' + (row.document_name || '—') + '</div>' +
          '</div>' +
        '</div>' +
        '<div class="bn-id-card">' +
          '<span class="bn-id-label">ID do Documento:</span>' +
          '<span class="bn-id-value">' + (row.document_id ? parseInt(row.document_id, 10) : '—') + '</span>' +
        '</div>' +
        (temUrl
          ? '<div class="bn-modal-msg">Use o botão abaixo para também abrir o contrato em uma nova guia.</div>'
          : '') +
        '<div class="bn-modal-msg">O processo será enviado automaticamente em ' +
          '<strong><span id="netlexCountdown">' + SEGUNDOS_AUTO_ENVIO + '</span>s</strong>…</div>' +
      '</div>',
    id: 'modalNetlexCriado',
    size: 'large',
    actions: [{
      label: temUrl ? 'Abrir contrato e enviar' : 'Enviar processo',
      bind: 'data-netlex-enviar',
      classType: 'btn-primary',
      autoClose: true
    }]
  });

  $(document).off('click.netlex').on('click.netlex', '[data-netlex-enviar]', function () {
    if (temUrl) window.open(row.document_url, '_blank');
    enviarProcesso();
  });

  // Qualquer forma de fechar o modal (X, ESC, clique fora) também envia.
  // Binding delegado no document: o FLUIGC remove o modal do DOM ao fechar,
  // então um handler ligado direto no elemento se perde; 'hide.bs.modal'
  // borbulha e dispara antes da remoção.
  $(document)
    .off('hide.bs.modal.netlex')
    .on('hide.bs.modal.netlex', '#modalNetlexCriado', enviarProcesso);

  // Contagem regressiva: ao zerar, dispara o clique no botão do modal — envia o
  // processo e tenta abrir a guia do NetLex. Por ser um clique programático,
  // a guia só abre se o navegador tiver popups liberados para o domínio do
  // Fluig; sem a liberação, apenas o envio acontece.
  let restantes = SEGUNDOS_AUTO_ENVIO;
  timerAutoEnvio = setInterval(function () {
    restantes--;
    $('#netlexCountdown').text(restantes);
    if (restantes <= 0) {
      clearInterval(timerAutoEnvio);
      $('[data-netlex-enviar]').trigger('click');
    }
  }, 1000);
}

// Loading de tela inteira na página pai (onde fica o botão de envio)
function criaLoadingNetlex() {
  try {
    if (parent.FLUIGC && parent.FLUIGC.loading) return parent.FLUIGC.loading(parent.window);
  } catch (err) { /* cross-origin: ignora */ }
  if (window.FLUIGC && window.FLUIGC.loading) return window.FLUIGC.loading(window);
  return null;
}

function obterNumProcesso() {
  let num = new URLSearchParams(window.location.search).get("WKNumProces");
  if (!num) {
    try {
      num = new URLSearchParams(parent.location.search).get("WKNumProces");
    } catch (err) { /* cross-origin: ignora */ }
  }
  return num || "";
}

function exibeToastNetlex(title, message, type) {
  const fluigc = window.FLUIGC || parent.FLUIGC;
  if (fluigc && fluigc.toast) {
    fluigc.toast({ title: title + ': ', message: message, type: type });
  } else {
    alert(title + ': ' + message);
  }
}

function copiarLinkNetlex() {
  var url = document.getElementById("bannerNetlexBtn").href;
  var msgEl = document.getElementById("bannerNetlexCopiado");

  function mostrarConfirmacao() {
    msgEl.style.opacity = "1";
    setTimeout(function () { msgEl.style.opacity = "0"; }, 2200);
  }

  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(url).then(mostrarConfirmacao);
  } else {
    var tmp = document.createElement("input");
    tmp.value = url;
    document.body.appendChild(tmp);
    tmp.select();
    document.execCommand("copy");
    document.body.removeChild(tmp);
    mostrarConfirmacao();
  }
}
