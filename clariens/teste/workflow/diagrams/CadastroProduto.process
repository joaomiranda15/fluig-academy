  <bpmn2:BpmnStartEvent esforcoCalculo="0" expediente="" extendedFields="&lt;list/&gt;" id="startevent4" instrucoes="Para solicitar o cadastro, o solicitante deve: - Preencher os campos do formul&#225;rio - Anexar, arquivos se necess&#225;rio. - Encaminhar solicita&#231;&#227;o, selecionado a op&#231;&#227;o &#8220;Enviar&quot;" name="Solicitar cadastro do produto" outgoing="flow28" selecionaColaboradores="1" signalId="0" type="10"/>
  <bpmn2:BpmnTask authNotify="true" esforcoCalculo="0" executionAttempts="0" expediente="" extendedFields="&lt;list/&gt;" frequency="0" id="task10" incoming="flow28 flow31 flow43" instrucoes="Ao receber a solicita&#231;&#227;o, o respons&#225;vel pela execu&#231;&#227;o da atividade deve:&#13;&#10;- Avaliar a necessidade da solicita&#231;&#227;o.&#13;&#10;- Verificar as informa&#231;&#245;es cadastradas e confront&#225;-las com as informa&#231;&#245;es contidas no Protheus. &#13;&#10;- Se o produto existir o Departamento de Compras efetua o de/para no produto e encerra a atividade, se n&#227;o possuir, encaminha para cadastro de informa&#231;&#245;es cont&#225;beis e fiscais.&#13;&#10;- Seguir a solicita&#231;&#227;o, selecionando a op&#231;&#227;o &#8220;Enviar&#8221;." loopType="0" managerAssignmentControllerString="&lt;org.eclipse.bpmn2.impl.AssignmentControllerFormField&gt;&#10;  &lt;formField&gt;respAvalCad&lt;/formField&gt;&#10;  &lt;mechanismName&gt;Campo Formul&#225;rio&lt;/mechanismName&gt;&#10;&lt;/org.eclipse.bpmn2.impl.AssignmentControllerFormField&gt;" managerMechanism="Campo Formul&#225;rio" name="Avaliar necessidade de cadastro" outgoing="flow13" prazoConclusao="960.0" selecionaColaboradores="1" type="80"/>
  <bpmn2:BpmnGateway condition="&lt;list&gt;&#10;  &lt;org.eclipse.bpmn2.impl.ConditionImpl&gt;&#10;    &lt;order&gt;1&lt;/order&gt;&#10;    &lt;expression&gt;hAPI.getCardValue(&amp;quot;avalCadastro&amp;quot;) == &amp;quot;maisInfo&amp;quot;&lt;/expression&gt;&#10;    &lt;targetTask&gt;task29&lt;/targetTask&gt;&#10;    &lt;conditionType&gt;0&lt;/conditionType&gt;&#10;  &lt;/org.eclipse.bpmn2.impl.ConditionImpl&gt;&#10;  &lt;org.eclipse.bpmn2.impl.ConditionImpl&gt;&#10;    &lt;order&gt;2&lt;/order&gt;&#10;    &lt;expression&gt;hAPI.getCardValue(&amp;quot;avalCadastro&amp;quot;) == &amp;quot;possuiCad&amp;quot;&lt;/expression&gt;&#10;    &lt;targetTask&gt;endevent20&lt;/targetTask&gt;&#10;    &lt;conditionType&gt;0&lt;/conditionType&gt;&#10;  &lt;/org.eclipse.bpmn2.impl.ConditionImpl&gt;&#10;  &lt;org.eclipse.bpmn2.impl.ConditionImpl&gt;&#10;    &lt;order&gt;3&lt;/order&gt;&#10;    &lt;expression&gt;hAPI.getCardValue(&amp;quot;avalCadastro&amp;quot;) == &amp;quot;cadAprovado&amp;quot;&lt;/expression&gt;&#10;    &lt;targetTask&gt;task18&lt;/targetTask&gt;&#10;    &lt;conditionType&gt;0&lt;/conditionType&gt;&#10;  &lt;/org.eclipse.bpmn2.impl.ConditionImpl&gt;&#10;&lt;/list&gt;" extendedFields="&lt;list/&gt;" id="exclusivegateway12" incoming="flow13" name="Avalia&#231;&#227;o" outgoing="flow30 flow33 flow35" type="120"/>
  <bpmn2:BpmnTask authNotify="true" esforcoCalculo="0" executionAttempts="0" expediente="" extendedFields="&lt;list/&gt;" frequency="0" id="task18" incoming="flow33" instrucoes="Ao receber a solicita&#231;&#227;o, o respons&#225;vel pela execu&#231;&#227;o da atividade deve:&#13;&#10;- Cadastrar o produto.&#13;&#10;- Seguir a solicita&#231;&#227;o, selecionando a op&#231;&#227;o &#8220;Enviar&#8221;." loopType="0" managerAssignmentControllerString="&lt;org.eclipse.bpmn2.impl.AssignmentControllerPoolRole&gt;&#10;  &lt;roleId&gt;compras&lt;/roleId&gt;&#10;  &lt;mechanismName&gt;Pool Papel&lt;/mechanismName&gt;&#10;&lt;/org.eclipse.bpmn2.impl.AssignmentControllerPoolRole&gt;" managerMechanism="Pool Papel" name="Cadastrar informa&#231;&#245;es do produto" outgoing="flow23" prazoConclusao="960.0" selecionaColaboradores="1" type="80"/>
