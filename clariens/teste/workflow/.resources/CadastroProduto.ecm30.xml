        + &apos;			            	&lt;a href=&quot;&apos; + urlBase + &apos;/portal/p/1/pageworkflowview?app_ecm_workflowview_detailsProcessInstanceID=&apos; + dadosMail.numProc + &apos;&quot; target=&quot;_blank&quot;&gt; &apos;&#xd;
